LOGUARD_API_KEY=
LOGUARD_ENABLED=true
LOGUARD_BASE_URL=https://api.loguard.org
LOGUARD_ENV=production
LOGUARD_SERVICE=
LOGUARD_TIMEOUT=3
LOGUARD_RETRIES=2
LOGUARD_MAX_EVENT_BYTES=65536
LOGUARD_SPOOL_PATH=/var/spool/loguard
LOGUARD_BATCH_SIZE=50
LOGUARD_ALLOW_INSECURE_TRANSPORT=false
LOGUARD_TRUSTED_PROXIES=
LOGUARD_TRACK_ALL_REQUESTS=false
LOGUARD_QUEUE_EVENTS=false
LOGUARD_QUEUE_CONNECTION=
LOGUARD_QUEUE_NAME=default
