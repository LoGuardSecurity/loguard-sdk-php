{
    "name": "loguard/loguard-sdk",
    "description": "Official LoGuard SDK for PHP, with first-class Laravel integration.",
    "type": "library",
    "license": "MIT",
    "keywords": ["loguard", "security", "monitoring", "waf", "laravel"],
    "require": {
        "php": "^8.1",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-mbstring": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "orchestra/testbench": "^8.0 || ^9.0",
        "laravel/framework": "^10.0 || ^11.0",
        "phpstan/phpstan": "^1.11"
    },
    "suggest": {
        "laravel/framework": "Required to use the Laravel integration (LoGuard\\Sdk\\Laravel\\*)."
    },
    "autoload": {
        "psr-4": {
            "LoGuard\\Sdk\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "LoGuard\\Sdk\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "LoGuard\\Sdk\\Laravel\\LoGuardServiceProvider"
            ],
            "aliases": {
                "LoGuard": "LoGuard\\Sdk\\Laravel\\Facades\\LoGuard"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true
    }
}
