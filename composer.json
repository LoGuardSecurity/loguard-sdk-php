{
    "name": "loguard/loguard-sdk",
    "description": "Official LoGuard security telemetry SDK for PHP.",
    "type": "library",
    "license": "MIT",
    "keywords": ["loguard", "security", "monitoring", "waf", "psr-15", "laravel", "codeigniter"],
    "require": {
        "php": "^8.1",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-mbstring": "*"
    },
    "require-dev": {
        "laravel/framework": "^13.23",
        "orchestra/testbench": "^11.2",
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^12.4",
        "psr/http-message": "^1.1 || ^2.0",
        "psr/http-server-handler": "^1.0",
        "psr/http-server-middleware": "^1.0"
    },
    "suggest": {
        "laravel/framework": "Required for the Laravel adapter.",
        "psr/http-message": "Required for the PSR-15 adapter.",
        "psr/http-server-middleware": "Required for the PSR-15 adapter."
    },
    "autoload": {
        "psr-4": {
            "LoGuard\\Sdk\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "LoGuard\\Sdk\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/loguard-spool-worker"
    ],
    "extra": {
        "laravel": {
            "providers": [
                "LoGuard\\Sdk\\Laravel\\LoGuardServiceProvider"
            ],
            "aliases": {
                "LoGuard": "LoGuard\\Sdk\\Laravel\\Facades\\LoGuard"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit",
        "phpstan": "phpstan analyse src --level=7"
    }
}
