#!/usr/bin/env php
<?php

declare(strict_types=1);

use LoGuard\Sdk\Client;
use LoGuard\Sdk\Config;
use LoGuard\Sdk\Dispatch\FileSpool;
use LoGuard\Sdk\Dispatch\SpoolWorker;

$autoloadCandidates = [];

if (
    isset($GLOBALS['_composer_autoload_path'])
    && is_string($GLOBALS['_composer_autoload_path'])
) {
    $autoloadCandidates[] = $GLOBALS['_composer_autoload_path'];
}

$autoloadCandidates[] = dirname(__DIR__) . '/vendor/autoload.php';
$autoloadCandidates[] = dirname(__DIR__) . '/autoload.php';

$autoload = null;

foreach ($autoloadCandidates as $candidate) {
    if (is_file($candidate)) {
        $autoload = $candidate;
        break;
    }
}

if ($autoload === null) {
    fwrite(
        STDERR,
        "LoGuard SDK autoload file not found. Install with Composer "
        . "or use the official standalone package.\n"
    );
    exit(2);
}

require $autoload;

$apiKey = (string) getenv('LOGUARD_API_KEY');
$spoolPath = (string) (getenv('LOGUARD_SPOOL_PATH') ?: '/var/spool/loguard');
$batchSize = (int) (getenv('LOGUARD_BATCH_SIZE') ?: 50);

try {
    $config = Config::fromArray([
        'api_key' => $apiKey,
        'base_url' => getenv('LOGUARD_BASE_URL') ?: Config::DEFAULT_BASE_URL,
        'env' => getenv('LOGUARD_ENV') ?: 'production',
        'service' => getenv('LOGUARD_SERVICE') ?: null,
        'timeout' => getenv('LOGUARD_TIMEOUT') ?: Config::DEFAULT_TIMEOUT,
        'retries' => getenv('LOGUARD_RETRIES') ?: Config::DEFAULT_RETRIES,
        'max_event_bytes' => getenv('LOGUARD_MAX_EVENT_BYTES') ?: Config::DEFAULT_MAX_EVENT_BYTES,
        'allow_insecure_transport' => filter_var(
            getenv('LOGUARD_ALLOW_INSECURE_TRANSPORT') ?: 'false',
            FILTER_VALIDATE_BOOLEAN
        ),
    ]);
    $result = (new SpoolWorker(
        new Client($config),
        new FileSpool($spoolPath)
    ))->runOnceResult($batchSize);

    if ($result->processed > 0) {
        $message = "Accepted {$result->accepted} LoGuard event(s).";

        if ($result->dropped > 0) {
            $message .= " {$result->dropped} dropped by server policy.";
        }

        fwrite(STDOUT, $message . "\n");
    }

    exit(0);
} catch (Throwable $e) {
    fwrite(STDERR, 'LoGuard spool worker failed: ' . $e->getMessage() . "\n");
    exit(1);
}
