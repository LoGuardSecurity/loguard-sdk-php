{
  "name": "loguard/php-runtime",
  "description": "LoGuard application security telemetry runtime for PHP 7.4+.",
  "type": "library",
  "license": "MIT",
  "keywords": [
    "loguard",
    "security",
    "telemetry",
    "laravel",
    "php"
  ],
  "require": {
    "php": ">=7.4",
    "ext-json": "*",
    "ext-curl": "*"
  },
  "autoload": {
    "psr-4": {
      "LoGuard\\Runtime\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "LoGuard\\Runtime\\Tests\\": "tests/"
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "suggest": {
    "laravel/framework": "Required only when using the LoGuard Laravel Runtime adapter."
  },
  "extra": {
    "laravel": {
      "providers": [
        "LoGuard\\Runtime\\Laravel\\LoGuardRuntimeServiceProvider"
      ]
    }
  },
  "bin": [
    "bin/loguard-runtime-worker"
  ]
}
