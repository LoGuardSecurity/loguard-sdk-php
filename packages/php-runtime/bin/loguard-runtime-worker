#!/usr/bin/env php
<?php

declare(strict_types=1);

use LoGuard\Runtime\Delivery\CurlTransport;
use LoGuard\Runtime\Delivery\DeliveryConfig;
use LoGuard\Runtime\Dispatch\FileSpool;
use LoGuard\Runtime\Dispatch\SpoolWorker;

$autoloadCandidates = array();

if (
    isset($GLOBALS['_composer_autoload_path'])
    && is_string($GLOBALS['_composer_autoload_path'])
) {
    $autoloadCandidates[] =
        $GLOBALS['_composer_autoload_path'];
}

$autoloadCandidates[] =
    dirname(__DIR__) . '/vendor/autoload.php';

$autoloadCandidates[] =
    dirname(__DIR__) . '/autoload.php';

$autoload = null;

foreach ($autoloadCandidates as $candidate) {
    if (is_file($candidate)) {
        $autoload = $candidate;
        break;
    }
}

if ($autoload === null) {
    fwrite(
        STDERR,
        "LoGuard Runtime autoload file not found. "
        . "Install the package with Composer.\n"
    );

    exit(2);
}

require $autoload;

/**
 * Read an environment value without assuming putenv() is enabled.
 *
 * @return string|null
 */
function loguardRuntimeEnv(string $name): ?string
{
    $value = getenv($name);

    if ($value !== false && $value !== '') {
        return (string) $value;
    }

    if (
        isset($_ENV[$name])
        && (string) $_ENV[$name] !== ''
    ) {
        return (string) $_ENV[$name];
    }

    if (
        isset($_SERVER[$name])
        && (string) $_SERVER[$name] !== ''
    ) {
        return (string) $_SERVER[$name];
    }

    return null;
}

/**
 * Load a Laravel-style .env when phpdotenv is already available.
 */
function loguardRuntimeLoadDotEnv(string $root): void
{
    if (
        !is_file($root . '/.env')
        || !class_exists(\Dotenv\Dotenv::class)
    ) {
        return;
    }

    try {
        \Dotenv\Dotenv::createImmutable(
            $root
        )->safeLoad();
    } catch (\Throwable $e) {
        // Existing process environment still takes precedence.
    }
}

/**
 * Resolve the default spool without requiring Laravel to boot.
 */
function loguardRuntimeDefaultSpool(
    string $root
): string {
    if (
        is_file($root . '/artisan')
        && is_dir($root . '/storage')
    ) {
        return $root
            . '/storage/loguard-spool';
    }

    return '/var/spool/loguard';
}

$root = getcwd();

if ($root === false || $root === '') {
    $root = '.';
}

loguardRuntimeLoadDotEnv($root);

$apiKey =
    (string) (
        loguardRuntimeEnv(
            'LOGUARD_API_KEY'
        ) ?: ''
    );

$spoolPath =
    (string) (
        loguardRuntimeEnv(
            'LOGUARD_SPOOL_PATH'
        )
        ?: loguardRuntimeDefaultSpool(
            $root
        )
    );

$baseUrl =
    (string) (
        loguardRuntimeEnv(
            'LOGUARD_BASE_URL'
        )
        ?: DeliveryConfig::DEFAULT_BASE_URL
    );

$timeout =
    (float) (
        loguardRuntimeEnv(
            'LOGUARD_TIMEOUT'
        )
        ?: DeliveryConfig::DEFAULT_TIMEOUT
    );

$retries =
    (int) (
        loguardRuntimeEnv(
            'LOGUARD_RETRIES'
        )
        ?: DeliveryConfig::DEFAULT_RETRIES
    );

$batchSize =
    (int) (
        loguardRuntimeEnv(
            'LOGUARD_BATCH_SIZE'
        )
        ?: 50
    );

$allowInsecure =
    filter_var(
        loguardRuntimeEnv(
            'LOGUARD_ALLOW_INSECURE_TRANSPORT'
        ) ?: 'false',
        FILTER_VALIDATE_BOOLEAN
    );

try {
    $config = new DeliveryConfig(
        $apiKey,
        $baseUrl,
        $timeout,
        $retries,
        $allowInsecure
    );

    $transport =
        new CurlTransport($config);

    $spool =
        new FileSpool($spoolPath);

    $result = (
        new SpoolWorker(
            $transport,
            $spool
        )
    )->runOnceResult($batchSize);

    if ($result->processed > 0) {
        $message =
            'Accepted '
            . $result->accepted
            . ' LoGuard event(s).';

        if ($result->dropped > 0) {
            $message .=
                ' '
                . $result->dropped
                . ' dropped by server policy.';
        }

        fwrite(
            STDOUT,
            $message . PHP_EOL
        );
    }

    exit(0);
} catch (\Throwable $e) {
    fwrite(
        STDERR,
        'LoGuard Runtime worker failed: '
        . $e->getMessage()
        . PHP_EOL
    );

    exit(1);
}
